# GitHub owner/user/org
GITHUB_OWNER=YOUR_GITHUB_OWNER

# Repository names
FACTORY_REPO=agent-skill-factory
PUBLIC_SKILLS_REPO=agent-skills-public
PRIVATE_SKILLS_REPO=agent-skills-private

# Fine-grained GitHub personal access token; server-side only
GITHUB_TOKEN=github_pat_REPLACE_ME

# Bearer key used by the Custom GPT Action to call this API
ACTION_API_KEY=generate-a-long-random-secret

# Safety defaults
ALLOW_DIRECT_MAIN=false
DEFAULT_BASE_BRANCH=main
